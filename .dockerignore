# Source-level ignores. The Dockerfile only COPYs dist-server/linux-x64/,
# which itself references desktop/dist-renderer/. Both must be reachable from the
# build context even though .gitignore-style might suggest otherwise.
.git/
.github/
.scratch/
.cache/

# Build outputs we never want inside the image build context.
node_modules/
dist/

# dist-server is normally ignored (large, regenerable), but the Linux x64
# tree is the *whole point* of this image — keep it.
dist-server/
!dist-server/linux-x64/
!dist-server/linux-x64/**
dist-server-open/
dist-server-bundle/
dist-server-artifact/
dist-standalone/
dist-renderer-artifact/
dist-sandbox/
dist-computer-use/
dist-open-export/

# desktop/dist-renderer is produced by `npm run build:renderer` inside the
# workflow; the build context needs to ship whatever it generates through to
# COPY. Likewise dist-splash (produced by `build:splash`).
desktop/dist-splash/
desktop/main.bundle.cjs
desktop/preload.bundle.cjs

# Vendored / runtime artifacts that should not bloat the build context.
vendor/
inbox/

# Test fixtures and the test runner itself.
tests/
*.test.ts
*.test.tsx
*.spec.ts

# Logs and crash dumps.
*.log
logs/

# Editor / OS scratch.
.DS_Store
.vscode/
.idea/
*.code-workspace

# AI / agent artifacts that should never end up in the image.
.claude/
.agents/skills/

# Hana-agent-internal scratch files (transient, never source-of-truth).
devlog/
tmp/
test-results/

# The Dockerfile and compose file themselves; harmless but pointless.
Dockerfile
.dockerignore
docker-compose.yml